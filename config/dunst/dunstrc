# ============================================================
# Dunst Notification Daemon Configuration
# Theme: Cyberpunk Neon
# Updated for dunst >= 1.12 (new height/offset syntax)
# ============================================================

[global]
    # --- Display ---
    monitor = 0
    follow  = mouse

    # Width: (min, max) in pixels
    width   = (0, 420)
    # Height: (min, max) — new syntax for dunst >= 1.12
    height  = (0, 300)

    origin  = top-right
    # Offset: (horizontal, vertical) — new syntax
    offset  = (12, 48)

    scale = 0
    notification_limit = 10

    # --- Appearance ---
    padding             = 10
    horizontal_padding  = 14
    text_icon_padding   = 10

    frame_width  = 2
    frame_color  = "#00e5ff"

    corner_radius = 10
    gap_size      = 6
    sort          = yes

    # --- Text ---
    font          = JetBrains Mono 10
    line_height   = 2
    markup        = full
    format        = "<b>%a</b>\n%s\n%b"
    alignment     = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize     = middle
    ignore_newline = no
    stack_duplicates     = true
    hide_duplicate_count = false
    show_indicators      = yes

    # --- Icons ---
    icon_theme        = "Papirus-Dark, Adwaita"
    enable_recursive_icon_lookup = true
    icon_position     = left
    min_icon_size     = 32
    max_icon_size     = 64

    # --- History ---
    sticky_history = yes
    history_length = 20

    # --- Misc ---
    dmenu   = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/librewolf
    always_run_script = true
    title   = Dunst
    class   = Dunst

    # Mouse actions
    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all

# ============================================================
# Urgency levels — Cyberpunk colors
# ============================================================

[urgency_low]
    background  = "#0d0d1a"
    foreground  = "#8888cc"
    frame_color = "#1a1a2e"
    timeout     = 4

[urgency_normal]
    background  = "#0d0d1a"
    foreground  = "#e2e2ff"
    frame_color = "#00e5ff"
    timeout     = 6

[urgency_critical]
    background  = "#0d0d1a"
    foreground  = "#ff0055"
    frame_color = "#ff0055"
    timeout     = 0
