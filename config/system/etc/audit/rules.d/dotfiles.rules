# /etc/audit/rules.d/dotfiles.rules
# Managed by ./local_setup.sh harden.  Loaded by augenrules --load (or
# applied automatically on next auditd start).  Hand-edits survive
# only until the next `harden` run.
#
# To inspect events generated by these rules:
#   sudo ausearch -k identity         # passwd/shadow/group/gshadow writes
#   sudo ausearch -k sudoers          # sudoers edits
#   sudo ausearch -k modules          # kernel module load/unload
#   sudo ausearch -k mount            # mount/umount syscalls
#   sudo ausearch -k privesc          # OPTIONAL — see ENABLE_PRIVESC below
#
# All keys are namespaced under the `dotfiles-` prefix in spirit (we use
# short aliases above so `ausearch -k identity` reads naturally — but
# these are dotfiles-installed rules and `auditctl -l` will show them
# verbatim).  To disable individual rule sets, delete the corresponding
# block and run `sudo augenrules --load`.
#
# Rule subset rationale: this is the Debian-friendly minimum — identity
# files, sudoers, kernel modules, and mount.  CIS Level 2 adds dozens
# of process-tracing rules that flood logs on a desktop; we deliberately
# leave those out.  Add them if you're auditing a server.

# --- identity files -----------------------------------------------------
# Write/attribute changes to user/group databases.  Catches `useradd`,
# `usermod`, `passwd` (when run by root), `chage`, plus hand-edits.
-w /etc/passwd  -p wa -k identity
-w /etc/group   -p wa -k identity
-w /etc/shadow  -p wa -k identity
-w /etc/gshadow -p wa -k identity

# --- sudoers ------------------------------------------------------------
# Any change to sudoers is a privilege-boundary change worth logging.
-w /etc/sudoers   -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers

# --- kernel module load/unload -----------------------------------------
# init_module / finit_module / delete_module are the syscalls used by
# `modprobe` and `insmod` (and by any in-kernel rootkit installer).
# Logged on both 64-bit (b64) and 32-bit-compat (b32) syscall tables —
# omitting b32 leaves a gap on multi-arch hosts where a compat-mode
# binary can still hit the syscall.
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules

# --- mount / umount ----------------------------------------------------
# Filesystem-mount events.  Useful for catching USB-mass-storage attacks
# and `mount -o bind` exfiltration tricks.  -F auid>=1000 filters out
# the boot-time mounts done by systemd as PID 1 (auid==unset == 4294967295
# on the kernel side; >=1000 narrows to actual user-initiated mounts).
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k mount
-a always,exit -F arch=b32 -S mount,umount,umount2 -F auid>=1000 -F auid!=unset -k mount

# --- OPTIONAL: privilege escalation tracking ---------------------------
# execve() of sudo / su.  This is high-signal for forensics BUT generates
# a record for every single `sudo` invocation — on a desktop running
# polybar/i3blocks/conky that shell out to `sudo ss` etc., this can
# easily produce hundreds of events per minute.  Disabled by default.
#
# To enable: uncomment the four rules below, then `sudo augenrules --load`.
# To find what triggered an event:  sudo ausearch -k privesc -ts recent
#
# -a always,exit -F arch=b64 -S execve -F path=/usr/bin/sudo -k privesc
# -a always,exit -F arch=b32 -S execve -F path=/usr/bin/sudo -k privesc
# -a always,exit -F arch=b64 -S execve -F path=/usr/bin/su   -k privesc
# -a always,exit -F arch=b32 -S execve -F path=/usr/bin/su   -k privesc
