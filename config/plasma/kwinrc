[Compositing]
AllowTearing=true
Backend=OpenGL
Enabled=true
HiddenPreviews=5
WindowsBlockCompositing=true

[Desktops]
# Four virtual desktops, single row — mirrors the i3 workspace workflow
# (Mod+1..4 to switch, Mod+Shift+1..4 to move-window-to).  Bindings live
# in config/plasma/kglobalshortcutsrc.  Plasma persists per-desktop UUIDs
# in `Id_N=<uuid>` keys, but it is happy to (re)generate them at runtime
# if we only set Number+Rows here, so no UUID drift between machines.
Number=4
Rows=1

[NightColor]
Active=false

[Plugins]
blurEnabled=true
contrastEnabled=true
desktopgridEnabled=true
# Gentle focus depth — unfocused windows recede slightly (balanced).
diminactiveEnabled=true
overviewEnabled=true
slideEnabled=true
zoomEnabled=true
# Window open/close motion: "Scale" (windows ease in/out instead of
# popping).  AnimationDurationFactor=0.5 in kdeglobals keeps it snappy.
kwin4_effect_scaleEnabled=true
fadeEnabled=true

# Frosted-glass depth.  Blur is already enabled above; this tunes its
# strength (slider 1–15; 9 = medium-strong) with no grain.  Shows through
# the cyberpunk-glass panels, KRunner, and the 0.90-opacity terminal.
[Effect-blur]
BlurStrength=9
NoiseStrength=0

# Dim-inactive: gentle so it reads as depth, not a blackout (default 25).
[Effect-diminactive]
Dimstrength=12

[Wayland]
EnablePrimarySelection=true
InputMethod=

[Windows]
BorderlessMaximizedWindows=false
ElectricBorderCornerRatio=0.25
ElectricBorders=0
FocusPolicy=ClickToFocus
NextFocusPrefersMouse=false
RollOverDesktops=true
SeparateScreenFocus=false

[Xwayland]
Scale=1

[org.kde.kdecoration2]
ButtonsOnLeft=
ButtonsOnRight=IAX
CloseOnDoubleClickOnMenu=false
ShowToolTips=true
library=org.kde.breeze
theme=Breeze
