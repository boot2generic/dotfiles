[WM]
# Title-bar background for the FOCUSED window — 13,13,26 == #0d0d1a,
# the EXACT background colour alacritty paints (see
# config/alacritty/alacritty.toml [colors.primary] background).  When
# alacritty has focus the bar visually melts into the terminal window
# and only the cyan accent border (activeBlend, controlled by breezerc
# BorderSize) frames the whole thing.  This file is the source of
# truth — `plasma-apply-colorscheme` reads here and overwrites the
# matching keys in ~/.config/kdeglobals on every theme apply, so any
# change here ALSO needs to land in config/plasma/kdeglobals to keep
# the two in sync (otherwise the first deploy is correct but
# apply-theme.sh's plasma-apply-colorscheme call later silently
# reverts it).
activeBackground=13,13,26
activeBlend=0,229,255
activeForeground=0,229,255
inactiveBackground=18,18,31
inactiveBlend=85,85,170
inactiveForeground=136,136,204
