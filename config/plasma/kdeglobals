[WM]
# Title-bar background for the FOCUSED window.  Set to 13,13,26 ==
# #0d0d1a — the EXACT background colour alacritty uses (see
# config/alacritty/alacritty.toml [colors.primary] background).  When
# alacritty has focus the bar visually melts into the terminal window;
# you only see the 2 px cyan accent border (from activeBlend) framing
# the whole thing.  If we leave this at the previous 8,8,16 the bar
# is one shade darker than the terminal and reads as a separate slab.
activeBackground=13,13,26
# The thin coloured pen Breeze paints around the active window's
# perimeter.  This is the "cyan outline" the user asked for; visibility
# is governed by breezerc [Common] BorderSize (Normal = 2 px).
activeBlend=0,229,255
activeForeground=0,229,255
# Inactive windows — slightly lighter than the active bg so the
# focus state is still readable when several windows overlap.
inactiveBackground=18,18,31
inactiveBlend=85,85,170
inactiveForeground=136,136,204
